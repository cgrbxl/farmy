{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:farmy:schema:uc013:0.13-draft",
  "$defs": {
    "item.policy.input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "classification": {
          "enum": [
            "private",
            "restricted"
          ]
        },
        "allowedReaders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "owner",
              "reader"
            ]
          }
        }
      },
      "required": [
        "resourceId",
        "classification",
        "allowedReaders"
      ]
    },
    "item.policy.output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resourceId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "versionId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "resourceId",
            "versionId",
            "revision",
            "sha256",
            "size",
            "path"
          ]
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "classification": {
          "enum": [
            "private",
            "restricted"
          ]
        },
        "allowedReaders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "inheritedReaders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "const": "managed-copy"
        }
      },
      "required": [
        "resource",
        "sourceId",
        "ownerId",
        "entry",
        "title",
        "classification",
        "allowedReaders",
        "inheritedReaders",
        "importedAt",
        "mode"
      ]
    },
    "consumer.offer.input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resourceId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "versionId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "resourceId",
            "versionId",
            "revision",
            "sha256",
            "size",
            "path"
          ]
        },
        "grantId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "resource",
        "grantId"
      ]
    },
    "consumer.offer.output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "accepted": {
          "const": true
        }
      },
      "required": [
        "resourceId",
        "accepted"
      ]
    }
  }
}
