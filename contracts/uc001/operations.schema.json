      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "path"
      ]
    },
    "resource.inspect.input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "resourceId"
      ]
    },
    "resource.move.input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
