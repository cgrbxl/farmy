    "folder.list.output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$"
          }
        }
      },
      "required": [
        "entries"
      ]
    },
    "folder.read.input": {
      "type": "object",
      "additionalProperties": false,
